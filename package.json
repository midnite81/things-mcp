{
  "name": "@midnite81/things-mcp",
  "version": "1.0.4",
  "description": "A safe MCP server for Things 3 on macOS",
  "author": "Simon Rogers <webdev@midnite.uk>",
  "repository": {
    "type": "git",
    "url": "https://github.com/midnite81/things-mcp.git"
  },
  "homepage": "https://github.com/midnite81/things-mcp#readme",
  "bugs": {
    "url": "https://github.com/midnite81/things-mcp/issues"
  },
  "keywords": [
    "mcp",
    "things-3",
    "things3",
    "macos"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "things-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
